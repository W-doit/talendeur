# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# LinkedIn OAuth
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
VITE_LINKEDIN_REDIRECT_URI=http://localhost:8080/profile

# CV Parser API (FastAPI microservice)
# Provides: /parse-cv, /gap-analysis, /career-foresight, /job-matches (LinkedIn)
VITE_CV_PARSER_API_URL=https://your-render-url.onrender.com

# Optional: Google Analytics (only loads after cookie consent Accept)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Two-factor auth (TOTP) is handled by Supabase Auth MFA.
# Dashboard: Authentication → Multi-Factor (enable TOTP if needed).
# Also run database/mfa-recovery-codes.sql for backup recovery codes.

# Backend (Supabase Edge Functions)
# Set these as secrets: supabase secrets set LINKEDIN_CLIENT_SECRET=your_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
